{
  "dataset": "stead_demo",
  "variant": "LPPN-BASE",
  "seed": 42,
  "batch_size": 3,
  "epochs": 1,
  "learning_rate": 0.0001,
  "output_root": "outputs/smoke_test",
  "data": {
    "train_hdf5": "data/sample_stead/sample.hdf5",
    "train_csv": "data/sample_stead/train.csv",
    "validation_hdf5": "data/sample_stead/sample.hdf5",
    "validation_csv": "data/sample_stead/validation.csv",
    "test_hdf5": "data/sample_stead/sample.hdf5",
    "test_csv": "data/sample_stead/test.csv"
  },
  "teacher": {
    "id": "EQT-STEAD-demo",
    "batch_size": 3,
    "epochs": 1,
    "p_protocol": "EQT_STEAD_DEMO_P_DETERMINISTIC_OFF_V1",
    "feature_protocol": "EQT_STEAD_DEMO_PDEC4_F32_DETERMINISTIC_OFF_V1",
    "min_confidence": 0,
    "max_error_seconds": 60
  },
  "lambda_c": 0.5,
  "lambda_fp": 365000
}
